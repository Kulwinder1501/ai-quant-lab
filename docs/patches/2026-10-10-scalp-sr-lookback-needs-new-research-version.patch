+
+    expect(nearestConfirmedLevelDistancesAtr(current, [], config, atr)).toEqual({
+      nearestSupportDistanceAtr: Infinity,
+      nearestResistanceDistanceAtr: Infinity,
+    });
+    expect(nearestConfirmedLevelDistancesAtr(current, history, config, atr)).toEqual({
+      nearestSupportDistanceAtr: 0.5,
+      nearestResistanceDistanceAtr: 3,
+    });
+  });
+
+  it("is bounded: a level older than srLookbackBars is not read", () => {
+    const current = createContext({ close: 24_000 });
+    const old = priorBar(30, 24_000, [supportAt(23_990)]);
+    const filler = Array.from({ length: 29 }, (_, i) => priorBar(29 - i, 24_000));
+    const history = [old, ...filler];
+
+    expect(nearestConfirmedLevelDistancesAtr(current, history, { ...config, srLookbackBars: 10 }, atr).nearestSupportDistanceAtr).toBe(Infinity);
+    expect(nearestConfirmedLevelDistancesAtr(current, history, { ...config, srLookbackBars: 40 }, atr).nearestSupportDistanceAtr).toBe(0.5);
+  });
+
+  it("drops a level that price has since closed through", () => {
+    const current = createContext({ close: 24_000 });
+    // Support at 23,990 confirmed, then a bar closes at 23,980 (through it), then price recovers.
+    const history = [priorBar(6, 24_005, [supportAt(23_990)]), priorBar(4, 23_980), priorBar(2, 24_000)];
+    expect(nearestConfirmedLevelDistancesAtr(current, history, config, atr).nearestSupportDistanceAtr).toBe(Infinity);
+
+    // The same support survives when no later close violated it.
+    const intact = [priorBar(6, 24_005, [supportAt(23_990)]), priorBar(4, 23_995), priorBar(2, 24_000)];
+    expect(nearestConfirmedLevelDistancesAtr(current, intact, config, atr).nearestSupportDistanceAtr).toBe(0.5);
+  });
+
+  it("never reads a context that closes after the decision bar (no look-ahead)", () => {
