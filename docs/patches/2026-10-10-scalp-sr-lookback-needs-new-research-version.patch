+    expect(nearestConfirmedLevelDistancesAtr(current, [future], config, atr).nearestSupportDistanceAtr).toBe(Infinity);
+  });
+
+  it("ignores levels from another price-action algorithm version", () => {
+    const current = createContext({ close: 24_000 });
