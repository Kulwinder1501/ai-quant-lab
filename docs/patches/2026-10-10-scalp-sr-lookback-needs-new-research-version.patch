+/** A completed bar `barsBefore` bars before the default test candle (04:00Z open), 5m apart. */
+function priorBar(
+  barsBefore: number,
+  close: number,
+  priceActionEvents: StrategyMarketContext["priceActionEvents"] = [],
+): StrategyMarketContext {
+  const base = createContext({ close, priceActionEvents });
+  const openTime = new Date(base.candle.openTime.getTime() - barsBefore * 5 * 60 * 1000);
+  return {
+    ...base,
+    candle: { ...base.candle, id: `prior-${barsBefore}`, openTime, closeTime: new Date(openTime.getTime() + 5 * 60 * 1000) },
+  };
+}
+
+const supportAt = (level: number): StrategyMarketContext["priceActionEvents"][number] => ({
+  eventCode: "SUPPORT",
+  algorithmVersion: "price-action-v2",
+  direction: "BULLISH",
+  level,
+  confidence: 0.8,
+  details: {},
+});
+
+const resistanceAt = (level: number): StrategyMarketContext["priceActionEvents"][number] => ({
+  eventCode: "RESISTANCE",
+  algorithmVersion: "price-action-v2",
+  direction: "BEARISH",
+  level,
+  confidence: 0.8,
+  details: {},
+});
+
