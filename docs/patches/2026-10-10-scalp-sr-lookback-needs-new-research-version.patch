+    const pattern = {
+      code: "HAMMER" as const,
+      algorithmVersion: "candlestick-v1",
+      direction: "BULLISH" as const,
+      confidence: 0.85,
+      contextCandleIds: ["candle-1"],
+      details: {},
+    };
+    const current = createContext({ close: 24_000, atr, patterns: [pattern] });
+    const history = [priorBar(5, 24_000, [supportAt(23_990)])];
+
+    const without = strategy.evaluate(current, CONFIGURATION);
+    const withHistory = strategy.evaluate(current, CONFIGURATION, history);
+    expect(without).toEqual(strategy.evaluate(current, CONFIGURATION, []));
+    // The earlier support is worth confluence points that the current candle alone cannot supply.
+    expect(withHistory.length).toBe(1);
+    expect(withHistory[0]!.confidence).toBeGreaterThan(without[0]?.confidence ?? 0);
+  });
