+    expect(nearestConfirmedLevelDistancesAtr(current, [foreign], config, atr).nearestSupportDistanceAtr).toBe(Infinity);
+  });
+
+  it("lets evaluate() count a support confirmed earlier, and is unchanged when no history is supplied", () => {
