+/** How many prior completed bars are searched for still-standing support/resistance. */
+export const DEFAULT_SR_LOOKBACK_BARS = 20;
+
+/**
+ * Distance, in ATR, from the close to the nearest confirmed support and resistance level.
+ *
+ * SUPPORT / RESISTANCE events are stored on the pivot's *confirmation* bar (the pivot is not
+ * knowable earlier), so they exist on a handful of bars and a read of the current candle alone
+ * finds a level on almost none of them -- "near support" was almost never true. This reads the
+ * levels confirmed on any of the last `srLookbackBars` completed bars up to and including the
+ * decision bar. Everything used was stored on a bar that had already closed at decision time, so
+ * there is no look-ahead: contexts closing after the decision bar are ignored.
+ *
+ * A level that has since been closed through is a broken level, not a standing one: a support is
+ * dropped once any later close (up to the current bar) is below it, a resistance once any later
+ * close is above it.
+ */
+export function nearestConfirmedLevelDistancesAtr(
+  context: StrategyMarketContext,
+  priorContexts: readonly StrategyMarketContext[],
+  config: MomentumScalpPatternStrategyConfiguration,
+  atr: number,
+): { nearestSupportDistanceAtr: number; nearestResistanceDistanceAtr: number } {
+  const lookback = Math.max(0, Math.floor(config.srLookbackBars ?? DEFAULT_SR_LOOKBACK_BARS));
+  const decisionClose = context.candle.closeTime.getTime();
+  const history = priorContexts
+    .filter((prior) => (
+      prior.candle.id !== context.candle.id
+      && prior.candle.instrumentId === context.candle.instrumentId
+      && prior.candle.timeframe === context.candle.timeframe
+      && prior.candle.closeTime.getTime() <= decisionClose
+    ))
+    .sort((a, b) => a.candle.closeTime.getTime() - b.candle.closeTime.getTime());
+  // The window is the last `lookback` eligible bars plus the decision bar, oldest first.
+  const window = [...(lookback > 0 ? history.slice(-lookback) : []), context];
+
+  const distances = { support: Infinity, resistance: Infinity };
+  window.forEach((bar, barIndex) => {
+    for (const event of bar.priceActionEvents) {
+      if (event.level === null || event.algorithmVersion !== config.priceActionAlgorithmVersion) continue;
+      if (event.eventCode !== "SUPPORT" && event.eventCode !== "RESISTANCE") continue;
+      const level = event.level;
+      const later = window.slice(barIndex + 1);
+      const broken = event.eventCode === "SUPPORT"
+        ? later.some((laterBar) => laterBar.candle.close < level)
+        : later.some((laterBar) => laterBar.candle.close > level);
+      if (broken) continue;
+      const distance = Math.abs(context.candle.close - level) / atr;
+      if (event.eventCode === "SUPPORT") distances.support = Math.min(distances.support, distance);
+      else distances.resistance = Math.min(distances.resistance, distance);
+    }
+  });
+  return { nearestSupportDistanceAtr: distances.support, nearestResistanceDistanceAtr: distances.resistance };
+}
