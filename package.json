{
  "name": "ai-quant-lab",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev --workspace @ai-quant-lab/api",
    "dev:web": "npm run dev --workspace @ai-quant-lab/web",
    "db:migrate": "npm run db:migrate --workspace @ai-quant-lab/api",
    "data:seed:core-instruments": "npm run data:seed:core-instruments --workspace @ai-quant-lab/api",
    "data:register:instrument": "npm run data:register:instrument --workspace @ai-quant-lab/api --",
    "data:collect:historical": "npm run data:collect:historical --workspace @ai-quant-lab/api --",
    "data:collect:live": "npm run data:collect:live --workspace @ai-quant-lab/api --",
    "data:collect:institutional": "npm run data:collect:institutional --workspace @ai-quant-lab/api --",
    "data:collect:option-chain": "npm run data:collect:option-chain --workspace @ai-quant-lab/api --",
    "data:collect:option-premium-ticks": "npm run data:collect:option-premium-ticks --workspace @ai-quant-lab/api --",
    "paper:volatility-straddle": "npm run paper:volatility-straddle --workspace @ai-quant-lab/api --",
    "data:backfill:institutional": "npm run data:backfill:institutional --workspace @ai-quant-lab/api --",
    "data:auth:fyers": "npm run data:auth:fyers --workspace @ai-quant-lab/api --",
    "data:audit": "npm run data:audit --workspace @ai-quant-lab/api --",
    "data:reconcile:provisional": "npm run data:reconcile:provisional --workspace @ai-quant-lab/api --",
    "data:audit:sequence": "npm run data:audit:sequence --workspace @ai-quant-lab/api --",
    "data:detect-gaps": "npm run data:detect-gaps --workspace @ai-quant-lab/api --",
    "db:purge:yahoo-scalp": "npm run db:purge:yahoo-scalp --workspace @ai-quant-lab/api --",
    "analysis:calculate-indicators": "npm run analysis:calculate-indicators --workspace @ai-quant-lab/api --",
    "analysis:detect-patterns": "npm run analysis:detect-patterns --workspace @ai-quant-lab/api --",
    "analysis:generate-trade-ideas": "npm run analysis:generate-trade-ideas --workspace @ai-quant-lab/api --",
    "analysis:compare-scalp-profiles": "npm run analysis:compare-scalp-profiles --workspace @ai-quant-lab/api --",
    "paper:accounts:create": "npm run paper:accounts:create --workspace @ai-quant-lab/api --",
    "paper:trades:open": "npm run paper:trades:open --workspace @ai-quant-lab/api --",
    "ml:prune": "node scripts/run-python.mjs apps/ml/prune.py",
    "pipeline:eod": "npm run pipeline:eod --workspace @ai-quant-lab/api",
    "trading:paper:bot": "npm run trading:paper:bot --workspace @ai-quant-lab/api --",
    "agent:tick": "npm run agent:tick --workspace @ai-quant-lab/api --",
    "measure:directional-scorer": "npm run measure:directional-scorer --workspace @ai-quant-lab/api --",
    "measure:effective-sample-size": "npm run measure:effective-sample-size --workspace @ai-quant-lab/api --",
    "measure:strategy-tier": "npm run measure:strategy-tier --workspace @ai-quant-lab/api --",
    "paper:trades:evaluate": "npm run paper:trades:evaluate --workspace @ai-quant-lab/api --",
    "paper:trades:close": "npm run paper:trades:close --workspace @ai-quant-lab/api --",
    "paper:accounts:summary": "npm run paper:accounts:summary --workspace @ai-quant-lab/api --",
    "research:settle-candidates": "npm run research:settle-candidates --workspace @ai-quant-lab/api --",
    "research:experiment-a": "npm run research:experiment-a --workspace @ai-quant-lab/api --",
    "research:stop-sweep": "npm run research:stop-sweep --workspace @ai-quant-lab/api --",
    "backtest:run": "npm run backtest:run --workspace @ai-quant-lab/api --",
    "models:settle-predictions": "npm run models:settle-predictions --workspace @ai-quant-lab/api",
    "models:settle-auxiliary": "npm run models:settle-auxiliary --workspace @ai-quant-lab/api --",
    "models:compete:volatility": "npm run models:compete:volatility --workspace @ai-quant-lab/api --",
    "models:compete": "npm run models:compete --workspace @ai-quant-lab/api",
    "ml:train": "node scripts/run-python.mjs apps/ml/train.py",
    "ml:train:xgboost": "node scripts/run-python.mjs apps/ml/train.py --algorithm xgboost",
    "ml:train:lightgbm": "node scripts/run-python.mjs apps/ml/train.py --algorithm lightgbm",
    "ml:train:catboost": "node scripts/run-python.mjs apps/ml/train.py --algorithm catboost",
    "ml:train:tcn": "node scripts/run-python.mjs apps/ml/train_tcn.py",
    "ml:train:stack": "node scripts/run-python.mjs apps/ml/train_stack.py",
    "ml:register:sequence-shadow": "node scripts/run-python.mjs apps/ml/register_sequence_shadow.py",
    "ml:predict": "node scripts/run-python.mjs apps/ml/predict.py",
    "ml:predict:volatility-shadow": "npm run ml:predict -- --shadow-scheme volatility-expansion-v1",
    "ml:audit": "node scripts/run-python.mjs apps/ml/audit.py",
    "ml:test": "node scripts/run-python.mjs -m unittest discover -s apps/ml -p \"test_*.py\" -v",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "paper:trades:review": "npm run paper:trades:review --workspace @ai-quant-lab/api --",
    "risk:evaluate": "npm run risk:evaluate --workspace @ai-quant-lab/api --",
    "scheduler": "npm run scheduler --workspace @ai-quant-lab/api"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
