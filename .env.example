NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://ai_quant_lab:change_me@localhost:5432/ai_quant_lab
# Separate least-privilege login granted only scalp_research_writer capabilities.
SCALP_RESEARCH_DATABASE_URL=postgresql://ai_quant_scalp_research:change_research_password@localhost:5432/ai_quant_lab
POSTGRES_RESEARCH_USER=ai_quant_scalp_research
POSTGRES_RESEARCH_PASSWORD=change_research_password
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Comma-separated browser origins accepted by the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-IP state-changing requests accepted per minute.
API_MUTATION_RATE_LIMIT=120
POSTGRES_DB=ai_quant_lab
POSTGRES_USER=ai_quant_lab
POSTGRES_PASSWORD=change_me
# Optional, read-only historical data collection through Kite Connect v3.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
# Optional comma-separated manual NSE market holidays (YYYY-MM-DD) for live polling.
NSE_HOLIDAYS=
# Optional paid/provider symbol. Leave blank rather than substituting NIFTY spot.
GIFT_NIFTY_YAHOO_SYMBOL=
# Optional override for the provenance-filtered historical FII/DII archive.
FII_DII_HISTORY_URL=
# Stock Intelligence (M01). API stays off until Gate 7. Thresholds are configuration, not code.
STOCK_INTELLIGENCE_API_ENABLED=false
NEXT_PUBLIC_STOCK_INTELLIGENCE_ENABLED=false
STOCK_INTELLIGENCE_STALE_DATA_6M_DAYS=30
STOCK_INTELLIGENCE_STALE_DATA_12M_DAYS=60
STOCK_INTELLIGENCE_FUNDAMENTAL_COMPLETENESS_MIN=0.7
STOCK_INTELLIGENCE_MIN_EFFECTIVE_ANALOGUES=50
# Fyers API v3, read-only historical backfill. Minute data from 2017-07-03.
# Owns the 1m/3m/5m/10m timeframes; Yahoo keeps 15m/30m/60m/1d.
# The refresh token lasts 15 days; reconnect via Settings → Connect Fyers (or CLI).
# Redirect URI must match the Fyers app console exactly. Either works for local v2:
#   http://localhost:3001
#     → web catches auth_code and POSTs /api/v1/fyers/auth/exchange
#   http://localhost:4001/api/v1/fyers/auth/callback
#     → API exchanges directly, then redirects to Settings
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=
# Required for access-token refresh after Connect (never sent to the browser).
FYERS_PIN=
