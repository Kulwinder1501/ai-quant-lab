NODE_ENV=development
API_PORT=4000
WEB_PORT=3000
DATABASE_URL=postgresql://ai_quant_lab:change_me@localhost:5432/ai_quant_lab
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# Comma-separated browser origins accepted by the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Per-IP state-changing requests accepted per minute.
API_MUTATION_RATE_LIMIT=120
POSTGRES_DB=ai_quant_lab
POSTGRES_USER=ai_quant_lab
POSTGRES_PASSWORD=change_me
# Optional, read-only historical data collection through Kite Connect v3.
KITE_API_KEY=
KITE_ACCESS_TOKEN=
# Optional comma-separated manual NSE market holidays (YYYY-MM-DD) for live polling.
NSE_HOLIDAYS=
# Optional paid/provider symbol. Leave blank rather than substituting NIFTY spot.
GIFT_NIFTY_YAHOO_SYMBOL=
# Optional override for the provenance-filtered historical FII/DII archive.
FII_DII_HISTORY_URL=
# Fyers API v3, read-only historical backfill. Minute data from 2017-07-03.
# Owns the 1m/3m/5m/10m timeframes; Yahoo keeps 15m/30m/60m/1d.
# The refresh token lasts 15 days; reconnect via Settings → Connect Fyers (or CLI).
# Redirect URI must match the Fyers app console exactly. For local v2:
#   FYERS_REDIRECT_URI=http://localhost:4001/api/v1/fyers/auth/callback
FYERS_APP_ID=
FYERS_APP_SECRET=
FYERS_REDIRECT_URI=
# Required for access-token refresh after Connect (never sent to the browser).
FYERS_PIN=
